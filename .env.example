# Motsense environment variables (example)
# Copy to .env.local and fill in when connecting a backend.

# Supabase (optional — used when auth/database is connected)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MQTT broker (optional — used when live device stream is connected)
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
